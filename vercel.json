{
	"framework": "nextjs",
	"buildCommand": "next build",
	"routes": [
		{
			"src": "/(admin|minha-conta)/(.*)",
			"headers": {
				"Cache-Control": "no-store, must-revalidate",
				"X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet"
			}
		}
	],
	"functions": {
		"src/app/(private)/**": {
			"includeFiles": "src/app/(private)/**"
		}
	}
}
