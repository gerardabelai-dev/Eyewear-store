## 🔧 Integration Patterns

### 1. Resend + React Email Integration
```tsx
// ✅ Perfect integration pattern
export async function sendWelcomeEmail({ name, email, unsubscribeUrl }: Props) {
  try {
    const result = await resend.emails.send({
      from: "DrVista <noreply@drvista.com>",
      to: [email],
      subject: "Bem-vindo à DrVista!",
      react: WelcomeEmail({ name, unsubscribeUrl }),
      headers: {
        // Gmail thread prevention
        'Message-ID': `welcome-${Date.now()}-${Math.random()}@drvista.com`,
        'Date': new Date().toUTCString(),
        // Unsubscribe headers
        'List-Unsubscribe': `<${unsubscribeUrl}>`,
        'List-Unsubscribe-Post': 'List-Unsubscribe=One-Click',
      },
    });

    return { success: true, messageId: result.data?.id };
  } catch (error) {
    return { success: false, error: error.message };
  }
}
```

