### 4. **Order Update Email** (Status Changes)
```typescript
// ✅ ALREADY SECURE: Uses getCurrentUser()
// Location: src/lib/actions/order.ts - updateOrderStatus  
// Authentication: ✅ getCurrentUser() + order ownership check
// Risk: LOW - Proper authorization validation

export async function updateOrderStatus(data: UpdateStatusData) {
  const currentUser = await getCurrentUser();
  if (!currentUser) {
    return { error: "Usuário não autenticado" };
  }

  // ✅ SECURE: Check order ownership
  const existingOrder = await db
    .select()
    .from(order)
    .where(and(
      eq(order.id, data.id),
      eq(order.userId, currentUser.id) // ✅ Authorization check
    ));

  if (!existingOrder.length) {
    return { error: "Pedido não encontrado" };
  }

  // ✅ SECURE: Queue email for order customer
  await enqueueEmailJob({
    type: 'order-update',
    userId: currentUser.id,
    email: existingOrder[0].customerEmail,
    data: { status: data.status, orderNumber }
  });
}
```

## 🛡️ Required Security Implementation

### 1. **Create Secure QStash Job Processor**
```typescript
// src/app/api/jobs/process-email/route.ts
import { verifySignatureAppRouter } from "@upstash/qstash/nextjs";

async function handler(request: Request) {
  try {
    const { type, userId, email, data } = await request.json();

    // ✅ SECURE: Validate job payload
    const jobSchema = z.object({
      type: z.enum(['welcome', 'password-reset', 'order-confirmation', 'order-update']),
      userId: z.string().optional(),
      email: z.string().email(),
      data: z.record(z.any())
    });

    const validatedJob = jobSchema.parse({ type, userId, email, data });

    // ✅ SECURE: Only process valid email types
    switch (validatedJob.type) {
      case 'welcome':
        await sendWelcomeEmail(validatedJob);
        break;
      case 'password-reset':  
        await sendPasswordResetEmail(validatedJob);
        break;
      case 'order-confirmation':
        await sendOrderConfirmationEmail(validatedJob);
        break;
      case 'order-update':
        await sendOrderUpdateEmail(validatedJob);
        break;
    }

    return Response.json({ success: true });
  } catch (error) {
    return Response.json({ error: "Invalid job" }, { status: 400 });
  }
}

// ✅ SECURE: Verify QStash signature
export const POST = verifySignatureAppRouter(handler);
```

### 2. **Secure Email Queue Function**
```typescript
// src/lib/queue-service.ts
import { QStash } from "@upstash/qstash";

export async function enqueueEmailJob(job: EmailJob) {
  try {
    // ✅ SECURE: Validate job before queuing
    const emailJobSchema = z.object({
      type: z.enum(['welcome', 'password-reset', 'order-confirmation', 'order-update']),
      userId: z.string().optional(),
      email: z.string().email(),
      data: z.record(z.any())
    });

    const validatedJob = emailJobSchema.parse(job);

    await qstash.publishJSON({
      url: `${process.env.NEXT_PUBLIC_APP_URL}/api/jobs/process-email`,
      body: validatedJob,
      retries: 3,
      delay: 1000
    });

    // ✅ SECURE: Log job creation with user context
    await db.insert(userNotification).values({
      id: crypto.randomUUID(),
      userId: validatedJob.userId,
      type: validatedJob.type,
      email: validatedJob.email,
      status: 'queued',
      createdAt: new Date()
    });

  } catch (error) {
    console.error("Failed to queue email job:", error);
    throw new Error("Email job validation failed");
  }
}
```

### 3. **Authorization Middleware for API Routes**
```typescript
// src/lib/middleware/auth.ts
export async function requireAuth(request: Request) {
  const session = await getSession();
  
  if (!session?.user) {
    return Response.json(
      { error: "Authentication required" }, 
      { status: 401 }
    );
  }
  
  return session.user;
}

// Usage in API routes:
export async function POST(request: Request) {
  const user = await requireAuth(request);
  if (user instanceof Response) return user; // Auth failed
  
  // ✅ SECURE: Continue with authenticated user
}
```

